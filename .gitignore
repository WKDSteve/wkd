node_modules/
dist/
.astro/
.env
.env.*
.DS_Store
*.log

# demo recordings: fetched from the demo-assets branch (scripts/pull-demos.sh);
# /out/ is where VHS writes a local `vhs demos/<tape>.tape` (Output paths are
# relative to its working directory), never to be committed
public/demos/
demos/out/
/out/

# app icons: copied from the app repositories by the content loader on every
# build (src/loaders/repos.ts, copyIcon), never to be committed
public/app-icons/

# the pictures of the connections of each repo: copied from the repositories by the content loader
# (src/loaders/repos.ts, copyGraph); the three overviews in public/graphs/ are committed (written by the
# app-icons tool: graphs.mjs install-repos)
public/graphs/repo/

# pictures the test sheets take (TESTS/sheets, `shot` steps): written on every run
TESTS/sheets/out/

# demo fixtures may be .log files
!demos/fixtures/*.log

# Rust build output of the WASM sim core; the built .wasm itself is
# committed under src/lib/fight-engine/ (see scripts/build-wasm.mjs)
wasm/*/target/
