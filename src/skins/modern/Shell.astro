---
import Base from '../../components/Base.astro';
import Search from '../../components/Search.astro';
import '../../styles/modern.css';
import registry from '../../data/registry.json';
import { builtAreas } from '../../lib/nav';
import { href, MODES } from '../../lib/site';

interface Props {
  page: string;
  title: string;
  description: string;
}
const { page, title, description } = Astro.props;
const tuiHref = href(page, 'tui');
// The areas that have a page file; the brand is the link to the start page.
// Only the keys are used: nothing is imported, a planned area without a page
// (apps, play) simply is not in the list yet.
const areas = builtAreas(Object.keys(import.meta.glob('../../pages/**/*.astro'))).filter(
  (a) => a.page !== '',
);
---

<Base skin="modern" page={page} title={title} description={description}>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="m-header">
    <a class="m-brand" href={href('')} data-nav="" data-astro-prefetch>wkd</a>
    <Search placeholder="search" />
    <nav class="m-nav" aria-label="Site">
      {
        areas.map((a) => (
          <a
            href={href(a.page)}
            data-nav={a.page}
            aria-current={page === a.page || page.startsWith(`${a.page}/`) ? 'page' : undefined}
            data-astro-prefetch
          >
            {a.label}
          </a>
        ))
      }
      <label class="m-select">
        <span class="visually-hidden">Color mode</span>
        <select data-mode-select>
          {MODES.map((m) => <option value={m}>{m}</option>)}
        </select>
      </label>
      <a class="m-switch" href={tuiHref} data-skin-switch title="Switch to the TUI skin">[ tui ]</a>
    </nav>
  </header>
  <div class="m-hint" data-skin-hint hidden>
    You usually use the TUI skin — <a href={tuiHref}>switch back</a> or
    <button type="button" data-skin-keep>stay here</button>.
  </div>
  <main class="m-main" id="main"><slot /></main>
  <footer class="m-footer">
    <span class="m-footer-name">Neovim plugins and native apps from one workshop</span>
    <span>MIT License</span>
    <a href={`https://github.com/${registry.owner}?tab=repositories`} rel="noopener">Source on GitHub</a>
  </footer>
</Base>
