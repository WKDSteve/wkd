---
import { getCollection } from 'astro:content';
import Base from '../../components/Base.astro';
import Search from '../../components/Search.astro';
import '../../styles/tui.css';
import '../../styles/themes.css';
import { CATEGORIES } from '../../lib/format';
import { builtAreas, entryPage } from '../../lib/nav';
import { href, THEMES } from '../../lib/site';

interface Props {
  page: string;
  title: string;
  description: string;
  mode?: string;
  cmd?: string;
}
const { page, title, description, mode = 'NORMAL', cmd = '' } = Astro.props;
const modernHref = href(page, 'modern');

// Every entry is in the sidebar (the command line completes from it); the
// plugin categories come first, the categories of the apps after them.
const plugins = (await getCollection('plugins')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const pluginCount = plugins.filter((p) => p.data.kind === 'plugin').length;
const groups = Object.entries(CATEGORIES)
  .map(([id, label]) => ({ id, label, items: plugins.filter((p) => p.data.category === id) }))
  .filter((g) => g.items.length > 0);
// The areas that have a page file, minus the ones the sidebar places itself
// (the root, the plugin area, the activity log). Only the keys are used.
const moreAreas = builtAreas(Object.keys(import.meta.glob('../../pages/**/*.astro'))).filter(
  (a) => !['', 'nvim', 'activity'].includes(a.page),
);
// The entry whose page this is: p/<slug> for a plugin, apps/<slug> for an app.
const current = page.match(/^(?:p|apps)\/([^/]+)$/)?.[1] ?? null;
const file = page ? `~/wkd/${page}` : '~/wkd';
---

<Base skin="tui" page={page} title={title} description={description}>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="tui">
    <header class="tui-status" aria-label="Statusline">
      <span class="mode">{mode}</span>
      <span class="seg path">{file}</span>
      <span class="spacer"></span>
      <a class="seg" href={modernHref} data-skin-switch title="Switch to the modern skin">:set skin=modern</a>
      <label class="seg seg-select">
        <span aria-hidden="true">:colorscheme</span>
        <span class="visually-hidden">Colorscheme</span>
        <select data-theme-select>
          {THEMES.map((t) => <option value={t}>{t}</option>)}
        </select>
      </label>
      <span class="seg">utf-8</span>
    </header>
    <div class="tui-hint" data-skin-hint hidden>
      -- you usually use the modern skin: <a href={modernHref}>:set skin=modern</a> ·
      <button type="button" data-skin-keep>:set skin=tui</button> --
    </div>
    <div class="tui-body">
      <nav class="tui-side" aria-label="Site">
        <a class="root" href={href('', 'tui')} data-nav="">~/wkd/</a>
        <a class="grp-h" href={href('nvim', 'tui')} data-nav="nvim">
          <span aria-hidden="true">▸ </span>nvim/
        </a>
        {
          groups.map((g) => (
            <div class="grp">
              <div class="grp-h">
                <span aria-hidden="true">▾ </span>
                {g.label.toLowerCase()}/
              </div>
              {g.items.map((p) => (
                <a
                  class:list={['item', { cur: p.id === current }]}
                  href={href(entryPage(p.data), 'tui')}
                  data-nav={entryPage(p.data)}
                  data-vimdoc={p.data.hasVimdoc ? '' : undefined}
                  aria-current={p.id === current ? 'page' : undefined}
                >
                  {p.data.name}
                </a>
              ))}
            </div>
          ))
        }
        {
          moreAreas.map((a) => (
            <a class="grp-h" href={href(a.page, 'tui')} data-nav={a.page}>
              <span aria-hidden="true">▸ </span>
              {a.tui}
            </a>
          ))
        }
        <a class="grp-h" href={href('activity', 'tui')} data-nav="activity">
          <span aria-hidden="true">▸ </span>activity.log
        </a>
        <a class="grp-h" href={href('nvim/stack', 'tui')} data-nav="nvim/stack">
          <span aria-hidden="true">▸ </span>stack.txt
        </a>
      </nav>
      <main class="tui-main" id="main"><slot /></main>
    </div>
    <footer class="tui-cmd" aria-label="Command line">
      <Search placeholder={cmd} />
      <span class="pos">
        {/* `?` is handled by src/scripts/vim.ts; hidden without scripting (tui.css). */}
        <span class="pos-keys"><kbd>?</kbd> keys · </span>{pluginCount} plugins
      </span>
    </footer>
  </div>
  {/* Opened by `?` (src/scripts/vim.ts); a native <dialog>, Esc closes it. */}
  <dialog class="tui-help" data-help aria-labelledby="help-title">
    <h2 class="tui-h1" id="help-title">keys</h2>
    <dl class="tui-kv">
      <dt>j / k</dt>
      <dd>next / previous line</dd>
      <dt>gg / G</dt>
      <dd>first / last line</dd>
      <dt>⏎</dt>
      <dd>open the line under the cursor</dd>
      <dt>/</dt>
      <dd>search plugins and apps (<code>app: x</code> or <code>plugin: x</code> narrows)</dd>
      <dt>:</dt>
      <dd>command line — <kbd>Tab</kbd> completes</dd>
      <dt>:help x</dt>
      <dd>vimdoc of a plugin (<code>:e x</code> = plugin page)</dd>
      <dt>:ls · :apps · :play · :log · :stack</dt>
      <dd>plugin list · app list · play area · activity stream · dependency graph</dd>
      <dt>:log apps</dt>
      <dd>the stream of one area (<code>plugins</code> or <code>apps</code>)</dd>
      <dt>:colo x</dt>
      <dd>colorscheme</dd>
      <dt>:set skin=</dt>
      <dd>modern | tui</dd>
      <dt>?</dt>
      <dd>this help</dd>
      <dt>esc</dt>
      <dd>close</dd>
    </dl>
    <form method="dialog"><button class="tui-help-close">:q</button></form>
  </dialog>
</Base>
