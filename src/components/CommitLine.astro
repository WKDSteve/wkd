---
import type { CollectionEntry } from 'astro:content';
import registry from '../data/registry.json';
import { AREA_MARKS, areaOfSlug, pageOfSlug } from '../lib/entries';
import { isoDay } from '../lib/format';
import { href, type Skin } from '../lib/site';

interface Props {
  commit: CollectionEntry<'activity'>['data'];
  skin: Skin;
  showPlugin?: boolean;
}
const { commit: c, skin, showPlugin = true } = Astro.props;
// A commit of an app links to the app's page, one of a plugin to the plugin's.
const page = pageOfSlug(c.plugin);
// Which area the commit is from: the mark of the line, and what a filter keys on.
const area = areaOfSlug(c.plugin);
// Abbreviated SHA: GitHub resolves it, and 432 full SHAs are ~10 KB gzip on
// the activity page. 12 hex chars cannot collide in repos this size.
const commitUrl = `https://github.com/${registry.owner}/${c.pluginName}/commit/${c.sha.slice(0, 12)}`;
---

<li data-area={area}>
  <time datetime={c.date}>{isoDay(c.date)}</time>
  {
    showPlugin ? (
      <>
        <span class="carea" data-area={area}>{AREA_MARKS[area]}</span>
        <a class="cplug" href={href(page, skin)} data-nav={page}>
          {c.pluginName}
        </a>
      </>
    ) : null
  }
  <span class="ctype" data-type={c.type ?? 'none'}>{c.type ?? '·'}</span>
  <a class="csubj" href={commitUrl} rel="noopener">
    {c.scope ? `${c.scope}: ` : ''}{c.subject}
  </a>
</li>
