---
import { getCollection } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import Demo from '../../../components/Demo.astro';
import Moved from '../../../components/Moved.astro';
import RecentCommits from '../../../components/RecentCommits.astro';
import Shots from '../../../components/Shots.astro';
import { categoryLabel, lazySnippet } from '../../../lib/format';
import { entryPage } from '../../../lib/nav';
import { href } from '../../../lib/site';
import Shell from '../../../skins/tui/Shell.astro';

export async function getStaticPaths() {
  const plugins = await getCollection('plugins');
  return plugins.map((plugin) => ({ params: { id: plugin.id }, props: { plugin } }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { plugin } = Astro.props as Props;
const d = plugin.data;
// An app, a web variant or a kit had this address before it had a page of its
// own kind under apps/; the address stays and sends on (MOVED in the build check).
const movedTo = d.kind === 'plugin' ? null : entryPage({ kind: d.kind, slug: plugin.id });
---

{movedTo ? <Moved to={movedTo} skin="tui" /> : (
<Shell page={`p/${plugin.id}`} title={`${d.name} — wkd`} description={d.tagline} cmd={`help ${plugin.id}`}>
  {d.banner ? <pre class="banner" aria-hidden="true" tabindex="-1">{d.banner}</pre> : null}
  <h1 class="tui-h1">{d.name}</h1>
  <p class="tui-p">{d.description}</p>

  <dl class="tui-kv">
    <dt>status</dt>
    <dd>{d.status}{d.statusNote ? <span class="tui-dim"> — {d.statusNote}</span> : null}</dd>
    <dt>category</dt>
    <dd>{categoryLabel(d.category)}</dd>
    {d.nvimMin ? <dt>neovim</dt> : null}
    {d.nvimMin ? <dd>{d.nvimMin}+</dd> : null}
    <dt>repo</dt>
    <dd><a href={d.url} rel="noopener">{d.url.replace('https://', '')}</a></dd>
    <dt>commits</dt>
    <dd>{d.commitCount}</dd>
    {d.hasVimdoc ? <dt>help</dt> : null}
    {d.hasVimdoc ? <dd><a href={href(`p/${plugin.id}/help`, 'tui')} data-nav={`p/${plugin.id}/help`}>:help {plugin.id}</a></dd> : null}
  </dl>

  {d.demos.length > 0 ? <h2 class="tui-h2">demo</h2> : null}
  {d.demos.length > 0 ? <Demo slug={plugin.id} demos={d.demos} skin="tui" /> : null}

  {d.shots.length > 0 ? <h2 class="tui-h2">screenshots</h2> : null}
  {d.shots.length > 0 ? <Shots slug={plugin.id} name={d.name} shots={d.shots} skin="tui" /> : null}

  <h2 class="tui-h2">install</h2>
  <pre class="tui-code"><code>{lazySnippet(d.owner, d.name)}</code></pre>

  {d.docs.length > 0 ? <h2 class="tui-h2">docs/</h2> : null}
  {
    d.docs.length > 0 ? (
      <ul class="tui-list">
        {d.docs.map((f) => (
          <li>
            <a href={`${d.url}/blob/HEAD/docs/${encodeURIComponent(f)}`} rel="noopener">{f}</a>
          </li>
        ))}
      </ul>
    ) : null
  }

  <h2 class="tui-h2">git log</h2>
  <RecentCommits commits={d.recent} skin="tui" />
</Shell>
)}
