---
import { getCollection } from 'astro:content';
import CommitLine from '../../components/CommitLine.astro';
import { byDateDesc } from '../../lib/format';
import { PLAY } from '../../lib/play';
import { href } from '../../lib/site';
import { doorExamples } from '../../lib/start';
import Shell from '../../skins/tui/Shell.astro';

// The start buffer: the same three ways on as the start page of the modern
// skin (plugins, apps, play), as a directory listing.
const items = (await getCollection('plugins')).map((e) => e.data);
const plugins = items.filter((i) => i.kind === 'plugin');
const apps = items.filter((i) => i.kind === 'app');
const activity = (await getCollection('activity')).sort(byDateDesc).slice(0, 8);
const names = (kind: 'plugin' | 'app'): string =>
  doorExamples(items, kind)
    .map((e) => e.name)
    .join(', ');
const dirs = [
  {
    page: 'nvim',
    cmd: ':ls',
    name: 'nvim/',
    text: `${plugins.length} Neovim plugins — ${names('plugin')}, …`,
  },
  {
    page: 'apps',
    cmd: ':apps',
    name: 'apps/',
    text: `${apps.length} native apps — ${names('app')}, …`,
  },
  {
    page: 'play',
    cmd: ':play',
    name: 'play/',
    text: `${PLAY.length} ${PLAY.length === 1 ? 'experiment' : 'experiments'} — ${PLAY.map((p) => p.name.toLowerCase()).join(', ')}`,
  },
];
// figlet -f Slant wkd
const banner = [
  '           __       __',
  ' _      __/ /______/ /',
  '| | /| / / //_/ __  / ',
  '| |/ |/ / ,< / /_/ /  ',
  '|__/|__/_/|_|\\__,_/',
].join('\n');
---

<Shell page="" title="wkd — Neovim plugins and native apps from one workshop" description="Neovim plugins, native apps and a few experiments from one workshop." cmd="cd">
  <pre class="banner" aria-hidden="true" tabindex="-1">{banner}</pre>
  <h1 class="tui-h1">one workshop · plugins · apps · experiments</h1>
  <p class="tui-p tui-dim">
    Generated from the repositories. Taglines, status and commits are read from source at build time.
  </p>

  <h2 class="tui-h2">ls ~/wkd/</h2>
  <div class="tui-table tui-start">
    {
      dirs.map((d) => (
        <a href={href(d.page, 'tui')} data-nav={d.page} data-astro-prefetch>
          <span class="idx">{d.cmd}</span>
          <span class="name">{d.name}</span>
          <span class="cat">{d.text}</span>
        </a>
      ))
    }
  </div>

  <h2 class="tui-h2">git log --all --oneline</h2>
  <ol class="tui-list">
    {activity.map((c) => <CommitLine commit={c.data} skin="tui" />)}
  </ol>
  <p class="tui-log"><b>:activity</b> for the full stream</p>
</Shell>
