---
import { getCollection } from 'astro:content';
import CommitLine from '../../components/CommitLine.astro';
import { byDateDesc, categoryLabel, pad2 } from '../../lib/format';
import { href } from '../../lib/site';
import Shell from '../../skins/tui/Shell.astro';

// The start page of the site. For now it is the plain way in: the plugin
// area, and the apps as a list until they have an area of their own.
const all = (await getCollection('plugins')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const plugins = all.filter((p) => p.data.kind === 'plugin');
const apps = all.filter((p) => p.data.kind === 'app');
const activity = (await getCollection('activity')).sort(byDateDesc).slice(0, 8);
// figlet -f Slant wkd
const banner = [
  '           __       __',
  ' _      __/ /______/ /',
  '| | /| / / //_/ __  / ',
  '| |/ |/ / ,< / /_/ /  ',
  '|__/|__/_/|_|\\__,_/',
].join('\n');
---

<Shell page="" title="wkd — Neovim plugins and native apps from one workshop" description={`${plugins.length} Neovim plugins and ${apps.length} native apps from one workshop.`} cmd="cd">
  <pre class="banner" aria-hidden="true" tabindex="-1">{banner}</pre>
  <h1 class="tui-h1">{plugins.length} plugins · {apps.length} apps · one workshop</h1>
  <p class="tui-p tui-dim">
    Generated from the repositories. Taglines, status and commits are read from source at build time.
  </p>

  <h2 class="tui-h2">nvim/</h2>
  <div class="tui-table">
    <a href={href('nvim', 'tui')} data-nav="nvim" data-astro-prefetch>
      <span class="idx">ls</span>
      <span class="name">nvim/</span>
      <span class="cat">{plugins.length} Neovim plugins, one family</span>
    </a>
    <a href={href('nvim/stack', 'tui')} data-nav="nvim/stack" data-astro-prefetch>
      <span class="idx">cat</span>
      <span class="name">stack.txt</span>
      <span class="cat">which plugin builds on which</span>
    </a>
  </div>

  <h2 class="tui-h2">apps</h2>
  <div class="tui-table">
    {
      apps.map((a, i) => (
        <a href={href(`p/${a.id}`, 'tui')} data-nav={`p/${a.id}`} data-astro-prefetch>
          <span class="idx">{pad2(i + 1)}</span>
          <span class="name">{a.data.name}</span>
          <span class="cat">{categoryLabel(a.data.category).toLowerCase()} — {a.data.tagline}</span>
        </a>
      ))
    }
  </div>

  <h2 class="tui-h2">git log --all --oneline</h2>
  <ol class="tui-list">
    {activity.map((c) => <CommitLine commit={c.data} skin="tui" />)}
  </ol>
  <p class="tui-log"><b>:activity</b> for the full stream</p>
</Shell>
