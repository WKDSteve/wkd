---
import { getCollection } from 'astro:content';
import CommitLine from '../components/CommitLine.astro';
import registry from '../data/registry.json';
import { byDateDesc } from '../lib/format';
import { href } from '../lib/site';
import Shell from '../skins/modern/Shell.astro';

// The start page of the site. For now it is the plain way in: the plugin
// area, and the apps as a list until they have an area of their own.
const all = (await getCollection('plugins')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const plugins = all.filter((p) => p.data.kind === 'plugin');
const apps = all.filter((p) => p.data.kind === 'app');
const activity = (await getCollection('activity')).sort(byDateDesc).slice(0, 10);
const title = 'wkd — Neovim plugins and native apps from one workshop';
const description = `${plugins.length} Neovim plugins and ${apps.length} native apps from one workshop, generated from their repositories.`;
---

<Shell page="" title={title} description={description}>
  <section class="m-hero">
    <p class="m-kicker">
      github.com/{registry.owner} · <b>{all.length} repositories</b>
    </p>
    <h1 class="display" data-kinetic>
      One <b>workshop</b>.
    </h1>
    <p class="m-lede">
      Neovim plugins and native apps, built side by side. This site is generated from the
      repositories themselves: every tagline, status and commit is read from the source.
    </p>
  </section>

  <section class="m-plugin" aria-label="Neovim plugins">
    <h2 class="m-h2">Neovim plugins</h2>
    <p class="m-lede">
      {plugins.length} plugins that share one rule — one command, one concern — and one tested
      foundation.
    </p>
    <p class="m-actions">
      <a class="m-btn" data-primary href={href('nvim')} data-nav="nvim" data-astro-prefetch>All plugins</a>
      <a class="m-btn" href={href('nvim/stack')} data-nav="nvim/stack" data-astro-prefetch>Stack</a>
    </p>
  </section>

  <section class="m-plugin" aria-label="Apps">
    <h2 class="m-h2">Apps</h2>
    <p class="m-lede">
      {apps.length} native apps: tools that stand on their own, and companions of the plugins.
    </p>
    <ul class="m-list">
      {
        apps.map((a) => (
          <li>
            <a href={href(`p/${a.id}`)} data-nav={`p/${a.id}`} data-astro-prefetch>
              {a.data.name}
            </a>
            {' — '}
            {a.data.tagline}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="m-plugin" aria-label="Recent activity">
    <h2 class="m-h2">Recent activity</h2>
    <ol class="m-list">
      {activity.map((c) => <CommitLine commit={c.data} skin="modern" />)}
    </ol>
    <p><a class="m-btn" href={href('activity')} data-nav="activity" data-astro-prefetch>Full stream</a></p>
  </section>
</Shell>
