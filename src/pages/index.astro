---
import { getCollection } from 'astro:content';
import CommitLine from '../components/CommitLine.astro';
import GraphPicture from '../components/GraphPicture.astro';
import Ticker from '../components/Ticker.astro';
import registry from '../data/registry.json';
import { byDateDesc } from '../lib/format';
import { entryPage } from '../lib/nav';
import { PLAY } from '../lib/play';
import { BASE, href } from '../lib/site';
import { doorExamples, SHOWN_STATS, workshopStats } from '../lib/start';
import Shell from '../skins/modern/Shell.astro';

// The way into the workshop: what it is, a door to the plugins and one to the
// apps, the play area, and what happened last in any of the repositories.
const items = (await getCollection('plugins')).map((e) => e.data);
const plugins = items.filter((i) => i.kind === 'plugin');
const apps = items.filter((i) => i.kind === 'app');
const activity = (await getCollection('activity')).sort(byDateDesc).slice(0, 10);
const statsPool = workshopStats(items, PLAY.length);
const doors = [
  {
    page: 'nvim',
    count: plugins.length,
    title: 'Neovim plugins',
    text: 'One command, one concern, and one tested foundation under all of them.',
    go: 'All plugins',
    examples: doorExamples(items, 'plugin'),
  },
  {
    page: 'apps',
    count: apps.length,
    title: 'Apps',
    text: 'Native programs: tools that stand on their own, and companions that give a plugin a window.',
    go: 'All apps',
    examples: doorExamples(items, 'app'),
  },
];
const title = 'wkd — Neovim plugins and native apps from one workshop';
const description =
  'Neovim plugins, native apps and a few experiments from one workshop, generated from their repositories.';
---

<Shell page="" title={title} description={description}>
  <section class="m-hero">
    <p class="m-kicker">
      github.com/{registry.owner} · <b>{items.length} repositories</b> · read from the source
    </p>
    <h1 class="display" data-kinetic>
      One <b>workshop</b>.
    </h1>
    <p class="m-lede">
      Plugins, apps, experiments. Neovim plugins and native apps are built here side by side, and
      now and then something just for fun. This site is generated from the repositories
      themselves: every tagline, status and commit is read from the source.
    </p>
    <dl class="m-stats" data-stats-pool={JSON.stringify(statsPool)}>
      {
        statsPool.slice(0, SHOWN_STATS).map((m) => (
          <div>
            <dt><span class="m-stat-label">{m.label}</span></dt>
            <dd><span class="m-stat-value">{m.value}</span></dd>
          </div>
        ))
      }
    </dl>
  </section>

  <Ticker commits={activity.map((c) => c.data)} label="Latest commits across all repositories" marks />

  <section class="m-doors" aria-label="Areas">
    {
      doors.map((d) => (
        <article class="m-card m-app m-door">
          <p class="m-door-count">{d.count}</p>
          <h2 class="m-door-title">
            <a class="m-app-link" href={href(d.page)} data-nav={d.page} data-astro-prefetch>{d.title}</a>
          </h2>
          <p class="m-card-tag">{d.text}</p>
          <ul class="m-door-examples">
            {d.examples.map((e) => (
              <li>
                <a href={href(entryPage(e))} data-nav={entryPage(e)}>{e.name}</a>
                <span>{e.tagline}</span>
              </li>
            ))}
          </ul>
          <p class="m-door-go" aria-hidden="true">{d.go} →</p>
        </article>
      ))
    }
  </section>

  <section class="m-strip" aria-labelledby="start-play">
    <h2 class="m-strip-title" id="start-play">Play</h2>
    <p class="m-strip-text">
      {PLAY.map((p) => p.blurb).join(' ')}
    </p>
    <a class="m-btn" data-primary href={href('play')} data-nav="play" data-astro-prefetch>
      {PLAY.length === 1 ? `Play ${PLAY[0]?.name}` : 'To the play area'}
    </a>
  </section>

  <section class="m-plugin m-graph">
    <h2 class="m-h2">One idea, several forms</h2>
    <GraphPicture src={`${BASE}graphs/matrix.png`} alt="Every family of the workshop and the forms it comes in: Neovim plugin, desktop app, web page and phone page, pale where a form is planned" />
  </section>

  <section class="m-plugin" aria-label="Recent activity">
    <h2 class="m-h2">Recent activity</h2>
    <ol class="m-list">
      {activity.map((c) => <CommitLine commit={c.data} skin="modern" />)}
    </ol>
    <p><a class="m-btn" href={href('activity')} data-nav="activity" data-astro-prefetch>Full stream</a></p>
  </section>
</Shell>
