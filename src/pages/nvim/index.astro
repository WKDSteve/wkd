---
import { getCollection } from 'astro:content';
import CategoryFilter from '../../components/CategoryFilter.astro';
import CommitLine from '../../components/CommitLine.astro';
import FamilyTree from '../../components/FamilyTree.astro';
import OrbitView from '../../components/OrbitView.astro';
import Ticker from '../../components/Ticker.astro';
import registry from '../../data/registry.json';
import { alsoAs, formMark } from '../../lib/apps';
import { COMBOS, combosFor } from '../../lib/combos';
import { approx, byDateDesc, CATEGORIES, categoryLabel, pad2 } from '../../lib/format';
import { orbitLayout } from '../../lib/orbit';
import { BASE, href } from '../../lib/site';
import { buildStack, treeLayout } from '../../lib/stack';
import Shell from '../../skins/modern/Shell.astro';

// The area of the Neovim plugins: apps, web variants and kits have their own.
const entries = await getCollection('plugins');
const allData = entries.map((e) => e.data);
const plugins = entries
  .filter((p) => p.data.kind === 'plugin')
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const pluginIds = new Set(plugins.map((p) => p.id));
const stackNodes = buildStack(plugins);
const tree = treeLayout(stackNodes);
const orbit = orbitLayout(
  plugins.map((p) => ({ slug: p.id, name: p.data.name, category: p.data.category })),
  CATEGORIES,
);
const activity = (await getCollection('activity'))
  .filter((c) => pluginIds.has(c.data.plugin))
  .sort(byDateDesc)
  .slice(0, 10);
const features = plugins.reduce((n, p) => n + p.data.featureCount, 0);
const testFiles = plugins.reduce((n, p) => n + p.data.testFiles, 0);
// Counted per plugin: two plugins may define a tag of the same name.
const helpTags = plugins.reduce((n, p) => n + p.data.helpTagCount, 0);
const counts: Record<string, number> = {};
for (const p of plugins) counts[p.data.category] = (counts[p.data.category] ?? 0) + 1;
const pluginCount = plugins.length;
const title = 'wkd — a family of Neovim plugins';
const description = `${pluginCount} Neovim plugins from one workshop: AI, editing, navigation, debugging, project tooling — one command each, one shared foundation.`;

// T5: a pool of metrics the client rotates through, a slot at a time -- all
// derived from data already loaded above, nothing new to fetch. The first
// four stay the initial, no-script state (src/scripts/stats.ts progressively
// enhances from there).
const sum = (f: (p: (typeof plugins)[number]) => number) => plugins.reduce((n, p) => n + f(p), 0);
const countWhere = (f: (p: (typeof plugins)[number]) => boolean) => plugins.filter(f).length;
// Computed once and reused below (render loop + statsPool) instead of
// re-filtering COMBOS for the same slug up to three times per plugin.
const combosByPlugin = new Map(plugins.map((p) => [p.id, combosFor(p.id)]));
// The mark of a tile whose plugin also exists as an app or in a browser tab.
const markOf = new Map(
  plugins.map((p) => [p.id, formMark(alsoAs(allData, p.data).map((f) => f.item))]),
);
const statsPool = [
  { label: 'plugins', value: String(pluginCount) },
  { label: 'features', value: approx(features) },
  { label: 'help topics', value: approx(helpTags) },
  { label: 'test files', value: approx(testFiles) },
  { label: 'commits', value: approx(sum((p) => p.data.commitCount)) },
  { label: 'require() edges', value: String(stackNodes.reduce((n, p) => n + p.uses.length, 0)) },
  {
    label: 'optional integrations',
    value: String(stackNodes.reduce((n, p) => n + p.uses.filter((u) => u.optional).length, 0)),
  },
  { label: 'demos recorded', value: String(sum((p) => p.data.demos.length)) },
  { label: 'screenshots', value: String(sum((p) => p.data.shots.length)) },
  { label: 'vimdoc pages', value: String(sum((p) => p.data.vimdocs.length)) },
  { label: 'doc pages', value: String(sum((p) => p.data.docs.length)) },
  { label: 'stable', value: String(countWhere((p) => p.data.status === 'stable')) },
  { label: 'beta', value: String(countWhere((p) => p.data.status === 'beta')) },
  { label: 'alpha', value: String(countWhere((p) => p.data.status === 'alpha')) },
  { label: 'categories', value: String(Object.keys(counts).length) },
  { label: 'combos', value: String(COMBOS.length) },
  {
    label: 'in a combo',
    value: String(countWhere((p) => (combosByPlugin.get(p.id)?.length ?? 0) > 0)),
  },
  { label: 'standalone', value: String(countWhere((p) => p.data.uses.length === 0)) },
];
---

<Shell page="nvim" title={title} description={description}>
  <section class="m-hero">
    <p class="m-kicker">
      github.com/{registry.owner} · <b>{plugins.length} repositories</b>
    </p>
    <h1 class="display" data-kinetic>
      {pluginCount} plugins.<br />One <b>family</b>.
    </h1>
    <p class="m-lede">
      Neovim plugins that share one rule — one command, one concern — and one tested foundation.
      This site is generated from the repositories themselves: every tagline, status and commit
      below is read from the source.
    </p>
    <p class="m-actions">
      <a class="m-btn" href={href('nvim/stack')} data-nav="nvim/stack" data-astro-prefetch>Stack</a>
    </p>
    <dl class="m-stats" data-stats-pool={JSON.stringify(statsPool)}>
      {
        statsPool.slice(0, 4).map((m) => (
          <div>
            <dt><span class="m-stat-label">{m.label}</span></dt>
            <dd><span class="m-stat-value">{m.value}</span></dd>
          </div>
        ))
      }
    </dl>
  </section>

  <Ticker commits={activity.map((c) => c.data)} label="Latest commits across all plugins" />

  <div class="home">
    <fieldset class="view-switch">
      <legend class="visually-hidden">View</legend>
      <input type="radio" name="view" id="view-grid" class="visually-hidden" checked />
      <input type="radio" name="view" id="view-tree" class="visually-hidden" />
      <input type="radio" name="view" id="view-orbit" class="visually-hidden" />
      <div class="view-tabs">
        <label for="view-grid">Grid</label>
        <label for="view-tree">Tree</label>
        <label for="view-orbit">Orbit</label>
      </div>
      <p class="view-hint">
        <kbd>Esc</kbd> back to grid
      </p>
    </fieldset>
    <div class="m-filter">
      <CategoryFilter counts={counts} />
    </div>
    <section class="roster" aria-label="All plugins">
      {
        plugins.map((p, i) => (
          <a
            class="m-card"
            href={href(`p/${p.id}`)}
            data-nav={`p/${p.id}`}
            data-cat={p.data.category}
            data-astro-prefetch
          >
            <span class="m-card-head">
              <span>{pad2(i + 1)}</span>
              <span class="m-card-cat">{categoryLabel(p.data.category)}</span>
            </span>
            <span class="m-app-title m-plugin-title">
              {p.data.icon ? (
                <img class="m-app-icon" src={`${BASE}${p.data.icon}`} alt="" width="128" height="128" loading="lazy" />
              ) : null}
              <strong class="m-card-name">{p.data.name}</strong>
            </span>
            <span class="m-card-tag">{p.data.tagline}</span>
            {markOf.get(p.id) ? <span class="m-card-also">also as {markOf.get(p.id)}</span> : null}
            {
              (combosByPlugin.get(p.id)?.length ?? 0) > 0 && (
                <span class="m-card-combos">
                  {combosByPlugin.get(p.id)?.map((c) => (
                    <i class="m-combo-dot" data-combo={c.id} title={c.name} />
                  ))}
                </span>
              )
            }
            {
              p.data.description.length > p.data.tagline.length && (
                <span class="m-card-desc">{p.data.description}</span>
              )
            }
          </a>
        ))
      }
    </section>
    <section class="home-tree" aria-label="Plugin family tree">
      <FamilyTree tree={tree} />
      <p class="m-lede">
        {tree.isolated} further {tree.isolated === 1 ? 'plugin has' : 'plugins have'} no
        require() edge to a sibling and {tree.isolated === 1 ? "isn't" : "aren't"} shown here
        — see <a href={href('nvim/stack')} data-nav="nvim/stack" data-astro-prefetch>the stack</a> for the
        full breakdown.
      </p>
    </section>
    <section class="home-orbit" aria-label="Plugins by category">
      <OrbitView orbit={orbit} />
    </section>
  </div>

  <section class="m-plugin" aria-label="Recent activity">
    <h2 class="m-h2">Recent activity</h2>
    <ol class="m-list">
      {activity.map((c) => <CommitLine commit={c.data} skin="modern" />)}
    </ol>
    <p><a class="m-btn" href={href('activity')} data-nav="activity" data-astro-prefetch>Full stream</a></p>
  </section>
</Shell>
