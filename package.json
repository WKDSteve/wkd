{
  "name": "wkd",
  "version": "0.1.0",
  "private": true,
  "description": "Website of the wkd workshop: Neovim plugins and native apps -- generated from the repositories themselves.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"test/*.test.ts\"",
    "test:browser": "node --test test/browser/site.browser.mjs",
    "lhci": "node scripts/lhci.mjs",
    "budget": "node scripts/budget.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm build && pnpm budget"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "dependencies": {
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.14",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lhci/cli": "0.16.1",
    "@types/node": "^26.6.1",
    "@webgpu/types": "^0.1.74",
    "modern-web-guidance": "1.0.0",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
